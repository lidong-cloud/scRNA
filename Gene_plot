celltype_plot <- function(seob,gene,genedir){
  Idents(seob) <- 'celltype'
  l <- max(nchar(unique(seob$celltype)))
  n <- length(unique(seob$celltype))
  
  if(length(gene)<4){
    width <- length(gene)*(2.3 + n/30);height <- 1*(2+l/30)
  }else if(length(gene)<10) {
    width <- 3*(2.3 + n/30);height <- ceiling(length(gene)/3)*(2+l/30)
  }else if(length(gene)>9){ #兼容至16个
    width <- 4*(2.3 + n/30);height <- ceiling(length(gene)/4)*(2+l/30)
  }
  
  p <- VlnPlot(seob, features = gene, pt.size=0) + theme(legend.position = "none")
  for (i in 1:length(p)) {p[[i]] <- p[[i]]+labs(x='')}
  pdf(paste0(genedir,'/Celltype_violin.pdf'),width = 1.5*width, height = 1.5*height)
  print(p);dev.off()
  
  p <- DotPlot(seob,group.by = 'celltype',features = gene) + theme_test() +
    scale_color_gradient(low = c("#4DBBD5FF","#8491B4FF"), high = "#E64B35FF") +
    theme(axis.text.x=element_text(size=17,angle=60,hjust=1,vjust = 1),
          axis.text.y=element_text(size=17),
          legend.text = element_text(size=14),legend.title = element_text(size=16))+xlab('')+ylab('')
  pdf(paste0(genedir,'/Celltype_Stellate.pdf'),width = l/11 + 0.4*length(gene) + 2.9,height = 1.3 + n/3)
  print(p);dev.off()
}

gene_plot <- function(seob,cell,gene,genedir){
  cell <- gsub('/','_',gsub(' ','_',cell))
  n<-length(gene)
  p <- FeaturePlot_scCustom(seob,features = gene, pt.size = 1.2,
                            colors_use = c("#BEBEBE","#E8AD41","#D9792C","#A63D6A","#7807A1"))
  for (i in 1:length(p)) {
    p[[i]] <- p[[i]] + xlab('UMAP_1')+ylab('UMAP_2') + theme(axis.title = element_text(size = 13))+
      theme(axis.text.x=element_blank(),axis.ticks.x=element_blank(),axis.text.y=element_blank(),axis.ticks.y=element_blank(),
            plot.title = element_text(size = 18),axis.title = element_text(size = 16),
            legend.text = element_text(size=14),legend.title = element_text(size=16))
  }
  if (n==1) {h<-3.4;w<-3.6}else if(n<7){h<-ceiling(n/2)*3.4;w<-7.3}else{h<-10.2;w<-ceiling(n/3)*3.7}
  pdf(paste0(genedir, "/Makergene_",cell,"_", paste(gene,collapse='_'), ".UMAP.pdf"),height = h,width = w)
  print(p);dev.off()
  # 区分处理和对照
  p<-FeaturePlot_scCustom(seob,colors_use = c("#BEBEBE","#E8AD41","#D9792C","#A63D6A","#7807A1"),
                          split.by = 'group', pt.size = 1.2,
                          features = gene)
  for (i in 1:length(p)) {
    if(length(p[[i]])==2){
      p[[i]][[1]] <- p[[i]][[1]] + xlab('UMAP_1')+ylab('UMAP_2') +
        theme(axis.text.x=element_blank(),axis.ticks.x=element_blank(),axis.text.y=element_blank(),axis.ticks.y=element_blank(),
              plot.title = element_text(size = 18),axis.title = element_text(size = 16),legend.position="none")
      p[[i]][[2]] <- p[[i]][[2]] + xlab('UMAP_1')+ylab('UMAP_2') +
        theme(axis.text.x=element_blank(),axis.ticks.x=element_blank(),axis.text.y=element_blank(),axis.ticks.y=element_blank(),
              plot.title = element_text(size = 18),axis.title = element_text(size = 16),
              legend.text = element_text(size=14),legend.title = element_text(size=16))
    }else{
      p[[i]] <- p[[i]] + xlab('UMAP_1')+ylab('UMAP_2') +
        theme(axis.text.x=element_blank(),axis.ticks.x=element_blank(),axis.text.y=element_blank(),axis.ticks.y=element_blank(),
              plot.title = element_text(size = 18),axis.title = element_text(size = 16),
              legend.text = element_text(size=14),legend.title = element_text(size=16))
      }
    }
  pdf(paste0(genedir, "/Diffgene_",cell,"_",paste(gene,collapse='_'),".UMAP.pdf"),height = 3.3*n+0.2,width = 7.3)
  print(p);dev.off()
}

Volcano_plot <- function(seob,cell,gene,cop,logfc,pvalue,genedir){
  Idents(seob) <- 'group'
  cell <- gsub('/','_',gsub(' ','_',cell))
  deg <- FindMarkers(seob,min.pct = 0.0001,
                     ident.1 = unlist(cop[2]),ident.2 = unlist(cop[1]))
  deg <- cbind(row.names(deg),deg)[,c("row.names(deg)","pct.2","pct.1","avg_log2FC","p_val","p_val_adj")]
  colnames(deg) <- c("Geneid","pct_1","pct_2","logFC","P.Value","adjpval")
  
  deg$regulation <- ifelse((deg$P.Value < pvalue)&(deg$logFC > logfc),"UP",
                           ifelse((deg$P.Value < pvalue)&(deg$logFC < -logfc),"Down","Stable"))
  
  txt <- paste0(cop[1],'_VS_',cop[2],'\n',cell)
  xxx <- substitute(Log[2]*b, list(b="(fold change)"))
  yyy <- substitute(-Log[10]*b, list(b="(pvalue)"))
  m <- mean(c(15*mean(abs(deg$logFC)),mean(sort(abs(deg$logFC),decreasing =T)[1:20])))
  
  Geneid <- deg[deg$Geneid %in% gene,]
  p<-ggplot(deg, aes(x = logFC, y = -log10(P.Value))) +
    geom_point(size=1, aes(color=regulation)) +
    scale_color_manual(values=c("UP" = "red","Down" = "blue", "Stable" = "grey80"))+
    xlab(xxx) + ylab(yyy) +
    scale_x_continuous(expand = c(0,0),limits = c(-m,m))+
    geom_vline(xintercept=c(-logfc,logfc),lty=2,col="gray30",linewidth=0.8) +
    geom_hline(yintercept = -log10(pvalue),lty=2,col="gray30",linewidth=0.8) +
    theme_test()+ggtitle(txt) +
    ggrepel::geom_text_repel(Geneid,mapping = aes(x = logFC, y = -log10(P.Value),label=Geneid),
                             size=5,
                             box.padding = 3, #字到点的距离
                             point.padding = 0.1, #字到点的距离，点周围的空白宽度
                             min.segment.length = 0.2, #短线段可以省略
                             segment.size = 0.2,
                             segment.color = "black", #segment.colour = NA, 不显示线段
                             max.overlaps = getOption("ggrepel.max.overlaps", default = 100),
                             show.legend = F) + 
    theme(plot.title = element_text(size = 14),axis.title = element_text(size = 13),
          legend.text = element_text(size=12),legend.title = element_text(size=13),
          plot.margin = margin(b = 5,t = 10,l = 10,r = 15))
  
  pdf(paste0(genedir, "/Volcano_plot_",cell,".pdf"),height = 4,width = 4.3)
  print(p);dev.off()
  
  # txt <- paste0("Up genes: ",nrow(deg[deg$regulation=='UP',]),
  #               "\nDown genes: ",nrow(deg[deg$regulation=='Down',]))
  # p<-ggplot(deg,aes(x=pct_2,y=pct_1))+ 
  #   geom_point(size=0.5,aes(color = regulation))+ 
  #   scale_color_manual(values=c("UP" = "red","Down" = "blue", "Stable" = "grey80"))+
  #   xlab(paste0(cell,'   PCT_2')) + ylab(paste0(cell,'   PCT_1')) +
  #   theme_bw()+labs(subtitle = txt) +
  #   ggrepel::geom_text_repel(Geneid,mapping = aes(x = pct_2, y = pct_1,label= Geneid),
  #                            size=4,
  #                            box.padding = 2, #字到点的距离
  #                            point.padding = 0.1, #字到点的距离，点周围的空白宽度
  #                            min.segment.length = 0.5, #短线段可以省略
  #                            segment.size = 0.2,
  #                            segment.color = "black", #segment.colour = NA, 不显示线段
  #                            max.overlaps = getOption("ggrepel.max.overlaps", default = 100),
  #                            show.legend = F)
  # pdf(paste0(genedir, "/Diff_expr_plot.",cell,".pdf"),height = 3.8,width = 4)
