Stellate_plot <- function(seob,cell,gene,genedir){
  cell <- gsub('/','_',gsub(' ','_',cell))
  l <- max(nchar(levels(seob$group)))
  if(length(gene)>2){h<-0}else{h<-1}

  p <- DotPlot(seob,group.by = 'group',features = gene) + theme_test() +
  scale_color_gradient(low = c("#4DBBD5FF","#8491B4FF"), high = "#E64B35FF") +
  xlab('')+ylab('') + ggtitle(cell) +
  theme(plot.title = element_text(hjust=h,size = 16),
    axis.text.x=element_text(size=15,angle=60,hjust=1,vjust = 1),
    axis.text.y=element_text(size=15),
    legend.text = element_text(size=14),legend.title = element_text(size=14),
    plot.margin = margin(t = 45,r = 5,l = 20,b = 15))

  pdf(paste0(genedir, "/Stellate_plot_",cell,".pdf"),
      width = l/15 + 0.4*length(gene) + 2.7,height = 3.3 + max(nchar(gene))/20)
  print(p);dev.off()
}

box_plot <- function(seob,gene,Gid,cop,cell,type,genedir){
  cell <- gsub('/','_',gsub(' ','_',cell))
  exp <- tibble::rownames_to_column(as.data.frame(seob@assays$RNA$scale.data[gene,]))
  colnames(exp) <- c('cell','exp')
  meta <- tibble::rownames_to_column(seob@meta.data[c('group','celltype')],var = "cell")
  df <- inner_join(exp,meta,by='cell') %>% arrange(desc(exp))
  n <- max(table(df[df$exp!=min(df$exp),'group'])/table(df$group))
  if (n==0) {print(paste0('该基因在处理组和对照组均未表达: ',gene))}else{
    value <- length(df[df$group %in% cop[1],'group'])*n
    df1 <- df[df$group %in% cop[1],][floor(value*0.03):ceiling(value*0.95),]
    value <- length(df[df$group %in% cop[2],'group'])*n
    df2 <- df[df$group %in% cop[2],][floor(value*0.03):ceiling(value*0.95),]
    df <- rbind(df1,df2)
    df$group <- factor(df$group,levels = cop)
    col <- c("#E64B35FF","#7E6148FF","palevioletred", "#00A087FF", "#3C5488FF", "lightblue", "#F39B7FFF")
    
    if (is.na(Gid$P.Value)) {
      label = 'Pval = null'
    } else if (Gid$P.Value<0.001) {
      label = 'Pval < 0.001'
    } else {label = paste0('Pval = ',format(round(Gid$P.Value,3)))}
    txt <- paste0(gene,'  ',cell,'\n',label)
    
    p<-ggplot(df,aes(group,exp,fill = group))
    if (type=='violin') {p <- p + geom_violin()}else{p <- p + geom_boxplot()}
    p <- p + scale_fill_manual(values = sample(col,size = 2)) +
      geom_boxplot(width=0.1,position = position_identity(),fill="white") +
      theme_test() + xlab('') + ylab(paste0('EXP')) + ggtitle(txt) +
      theme(plot.title = element_text(hjust=0,size = 18),
            axis.text.x = element_text(size = 18),
            axis.title.y = element_text(size = 18),
            legend.position = "none",
            plot.margin = margin(b = 5,t = 10,l = 10,r = 25))
    pdf(paste0(genedir, "/",cop[1],'_VS_',cop[2],'.',cell,'_',gene,".",type,".pdf"),height = 4.5,width = 4.1)
    print(p);dev.off()
  }
}

main_plot <- function(seob,gene,cop,logfc,pvalue,type,genedir){
  cat('\n');print('All_celltype')
  celltype_plot(seob,gene,genedir)
  gene_plot(seob,'All_celltype',gene,genedir)
  Stellate_plot(seob,'All_celltype',gene,genedir)
  Geneid<-Volcano_plot(seob,'All_celltype',gene,cop,logfc,pvalue,genedir)
  for (g in Geneid$Geneid) {box_plot(seob,g,Geneid[g,],cop,'All_celltype',type,genedir)}
  if(nrow(Geneid)>0){dat <- cbind(Geneid,celltype='All_celltype')}

  for (cell in unique(seob$celltype)) {
    cat('\n');print(cell)
    cell_seob <- subset(seob,subset = celltype %in% cell)
    n <- table(cell_seob$group)
    if (length(n)<2) {
        print(paste0('The number of cells in some groups is too small, group1: ',n[1],'; group2: ',n[2]))
      }else{
        if (n[[1]]>30 & n[[2]]>30) {
            suppressMessages(cell_seob <- RunUMAP(cell_seob,reduction="harmony",n.neighbors = 50,spread = 10,min.dist = 0.5,dims = 1:10))
            gene_plot(cell_seob,cell,gene,genedir)
            Stellate_plot(cell_seob,cell,gene,genedir)
            Geneid<-Volcano_plot(cell_seob,cell,gene,cop,logfc,pvalue,genedir)
            for (g in gene) {box_plot(cell_seob,g,Geneid[g,],cop,cell,type,genedir)}
            if (nrow(Geneid)>0) {Geneid <- cbind(Geneid,celltype=cell)
               if(exists('dat')){dat<- rbind(dat,Geneid)}else{dat <- Geneid}}
            } else {print(paste0('The number of cells in some groups is too small, group1: ',n[1],'; group2: ',n[2]))}
      }
  }

  write.table(dat,paste0(genedir,'/Gene_expr_diff.xls'),
              sep ="\t",quote=F,col.names =T,row.names=F)
}
