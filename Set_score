Read_Celltype_data <- function(dir){
  if (file.exists(paste0(dir,'/Rdata/seob.Celltype.qs2'))) {
    seob <- qs_read(paste0(dir,'/Rdata/seob.Celltype.qs2'))
  }else{
    load(file = paste0(dir,'/Rdata/seob.Celltype.Rdata'))
    qs_save(seob,file = paste0(dir,'/Rdata/seob.Celltype.qs2'))
    file.remove(paste0(dir,'/Rdata/seob.Celltype.Rdata'))
  }
  return(seob)
}

