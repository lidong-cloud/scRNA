#!/usr/bin/Rscript
suppressPackageStartupMessages({
library(argparser)
})

parse <- arg_parser("=====================================================================\nThis script is used to analyze the differential expression between groups of scRNA\n=====================================================================",hide.opts = T)

parse <- add_argument(parse, "--dir", 
    help="Main directory of scRNA")
parse <- add_argument(parse, "--config_file", 
    help="config file containing sample information [default: dir + scRNA_config]")
parse <- add_argument(parse, "--logfc", default=0.58,
    help="The logfc cut off for the DEG analyse")
parse <- add_argument(parse, "--pvalue", default=0.01,
    help="The pvalue cut off for the DEG analyse")
parse <- add_argument(parse, "--object", default = "All",
    help="The scRNA object that need to be analyzed")

argv <- parse_args(parse)
if(is.na(argv$dir)){cat('\nThe parameters <dir> is required\n\n');print(parse);quit()}
if(is.na(argv$config_file)){
  if(file.exists(paste0(argv$dir,'/scRNA_config'))){argv$config_file <- paste0(argv$dir,'/scRNA_config')}else {cat('\nconfig file is missing\n\n');print(parse);quit()}
  }
dir <- argv$dir
config_file <- argv$config_file
logfc <- as.numeric(argv$logfc)
pvalue <- as.numeric(argv$pvalue)
object <- argv$object

suppressPackageStartupMessages({
library(scCustomize)
library(tidyverse)
library(Seurat)
library(qs2)
})

