    help="The scRNA object that need to be analyzed")
parse <- add_argument(parse, "--top", default=0.2,
    help="Take the Top correlation value as the result")
parse <- add_argument(parse, "--pvalue", default=0.01,
    help="The pvalue cut off for the correlation plot")
parse <- add_argument(parse, "--gene", 
    help="The genes used to draw correlation curves")
parse <- add_argument(parse, "--Point", default='',
    help="Mark the points of these genes on the correlation curved")
parse <- add_argument(parse, "--cell", default='Allcell',
    help="Which celltype to use in scRNA data")

argv <- parse_args(parse)
if(is.na(argv$dir)|is.na(argv$gene)){cat('\nThe parameters <dir> and <gene> is required\n\n');print(parse);quit()}
dir <- argv$dir
object <- argv$object
top <- as.numeric(argv$top)
pvalue <- as.numeric(argv$pvalue)
gene <- unique(strsplit(argv$gene,',')[[1]])
point <- unique(strsplit(argv$Point,',')[[1]])
cell <- argv$cell

