  seob <- qs_read(paste0(dir,'/Rdata/seob.Celltype.qs2'))
}else{
  seob <- qs_read(paste0(dir,'/Rdata/seob.Celltype_',object,'.qs2'))
}
cat("\n\n=============================Data reading completed==============================\n\n")

list <- sort_gene(seob,gene,point)
gene <- list[[1]];point <- list[[2]]

for (Group in c(unique(seob$group),'Allgroup')) {
  cat(paste0('\n\n===<<<',Group,'>>>===\n\n'))
  
  sub_seob <- seob
  if(cell!='Allcell'){sub_seob <- subset(sub_seob,subset = celltype %in% cell)}
  if(Group!='Allgroup'){sub_seob <- subset(sub_seob,subset = group %in% Group)}
  if (ncol(sub_seob) < 50) {cat(paste0("There are too few cells in [",Group,"], so we don't run any more"));next}
  
  cat("\n\n==================================Grouping cell==================================\n")
  sub_seob <- sort_seob(sub_seob,cell,Group)
  for (g in gene) {
    df <- Correlation_analysis(sub_seob,g,point,cell,Group,outdir)
  
    Correlation_plot(df[[1]],df[[2]],g,top,pvalue,cell,Group,outdir)
  }
}

